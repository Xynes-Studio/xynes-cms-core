{
  "name": "xynes-cms-core",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run scripts/run-with-env.ts run --watch src/index.ts",
    "start": "bun run scripts/run-with-env.ts run src/index.ts",
    "healthcheck": "bun -e 'const r=await fetch(`http://127.0.0.1:${process.env.PORT||4202}/health`);process.exit(r.ok?0:1)'",
    "test": "bun run scripts/run-with-env.ts test",
    "test:integration": "bun run scripts/run-with-env.ts run scripts/run-integration-tests.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/run-with-env.ts run src/infra/db/seed.ts",
    "test:coverage": "bun run scripts/run-with-env.ts test --coverage",
    "lint": "bun x biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "bun-types": "1.3.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3"
  }
}
