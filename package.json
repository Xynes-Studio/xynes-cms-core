{
  "name": "xynes-cms-core",
  "version": "1.0.0",
  "scripts": {
    "dev": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" run --watch src/index.ts'",
    "start": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" run src/index.ts'",
    "test": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" test'",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:seed": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" run src/infra/db/seed.ts'",
    "test:coverage": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" test --coverage'",
    "lint": "bun x biome check src"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.29.0",
    "hono": "^4.0.0",
    "postgres": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.20.0",
    "@types/pg": "^8.11.0"
  }
}
