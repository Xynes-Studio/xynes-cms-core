# DB-backed integration/feature tests require a reachable DATABASE_URL.
# Default here targets the repo docker compose (`docker-compose.test.yml`).
DATABASE_URL="postgresql://cms:cms@127.0.0.1:5433/cms_test"

# Enable DB-backed suites under `test/integration/**` and DB-dependent feature tests.
RUN_INTEGRATION_TESTS=true

# Dedicated identity fixture created by test/support/db/init.sql.
CMS_INTEGRATION_USER_ID=00000000-0000-4000-8000-000000000001

# Shared secret for service-to-service endpoints (must match gateway + other services).
INTERNAL_SERVICE_TOKEN=test-internal-token
