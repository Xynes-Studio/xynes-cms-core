# Use this when running tests via the platform SSH tunnel:
#   ssh -N -L 5432:127.0.0.1:5432 xynes@84.247.176.134
DATABASE_URL="postgresql://postgres.<TENANT_ID>:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres"

# Enable DB-backed suites under `test/integration/**` and DB-dependent feature tests.
RUN_INTEGRATION_TESTS=true

# Shared secret for service-to-service endpoints (must match gateway + other services).
INTERNAL_SERVICE_TOKEN=test-internal-token
